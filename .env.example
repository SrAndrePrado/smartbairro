# Modelo das variaveis de ambiente do projeto.
# Copie para um arquivo chamado .env caso queira testar localmente com
# configuracao de producao. O .env nunca vai para o repositorio.

# Chave secreta do Django. Em producao use um valor longo e aleatorio.
SECRET_KEY=troque-por-um-valor-longo-e-aleatorio

# False em producao. Sem DEBUG, o Django liga HTTPS, HSTS e cookies seguros.
DEBUG=True

# Dominios autorizados a servir a aplicacao, separados por virgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Conexao com o Postgres. Sem esta variavel, o projeto usa o SQLite local.
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Credencial do Cloudinary. Sem esta variavel, as imagens ficam em media/.
# CLOUDINARY_URL=cloudinary://chave:segredo@nome-da-conta

# Endereco do painel administrativo. Termine sempre com barra.
# Em producao, use algo dificil de adivinhar para reduzir trafego de robos.
ADMIN_URL=admin/

# Token que autentica o servico de mensageria no endpoint de ingestao.
INGESTAO_TOKEN=token-de-desenvolvimento-trocar-em-producao

# Administrador criado automaticamente no primeiro deploy.
# Use uma senha forte: esta conta tem acesso total ao painel.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=voce@exemplo.com
# DJANGO_SUPERUSER_PASSWORD=
